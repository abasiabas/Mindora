# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER exposed to the client. Server-side only (API routes / server actions).
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (configured mainly inside Supabase Auth dashboard) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenAI (AI layer) ─────────────────────────────────────
OPENAI_API_KEY=

# ── ZarinPal payment gateway ──────────────────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://yourdomain.com/api/payment/callback
ZARINPAL_SANDBOX=true

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# ── Security ──────────────────────────────────────────────
SESSION_SECRET=
